---
import Base from '../layouts/Base.astro';
import { getAllCodePaths, getEntriesForCode, getEntriesForNumeric } from '../lib/data';
import { getCachedNamespace } from '../lib/ns-cache';
import { getHue } from '../lib/namespace-hues';

export async function getStaticPaths() {
  const paths = await getAllCodePaths();
  return paths
    .filter(({ code }) => code !== '404')
    .map(({ code, isAlias }) => ({ params: { code }, props: { isAlias } }));
}

const { code } = Astro.params;
const { isAlias } = Astro.props;

const entries = isAlias
  ? await getEntriesForNumeric(parseInt(code, 10))
  : await getEntriesForCode(code);

const primary = entries[0];
const hue = primary ? getHue(primary.namespace) : 25;

let prevCode: (typeof entries)[0] | null = null;
let nextCode: (typeof entries)[0] | null = null;
let nearby: typeof entries = [];

if (!isAlias && primary) {
  const { codes: nsCodes } = await getCachedNamespace(primary.namespace);
  const idx = nsCodes.findIndex((c) => c.code === primary.code);
  prevCode = idx > 0 ? nsCodes[idx - 1] : null;
  nextCode = idx >= 0 && idx < nsCodes.length - 1 ? nsCodes[idx + 1] : null;
  const nearbyStart = Math.max(0, idx - 5);
  const nearbyEnd = Math.min(nsCodes.length, idx + 6);
  nearby = nsCodes.slice(nearbyStart, nearbyEnd);
}

function formatBadge(code: string): string {
  if (/^\d+$/.test(code)) {
    return `<span class="accent">${code}</span>`;
  }
  const m = code.match(/^([A-Z]+_|E)(.+)$/);
  if (m) {
    return `<span style="color:var(--muted-2)">${m[1]}</span><span class="accent">${m[2]}</span>`;
  }
  return `<span class="accent">${code}</span>`;
}

function shortenRef(url: string): string {
  try {
    const u = new URL(url);
    return u.host.replace(/^www\./, '') + (u.pathname === '/' ? '' : u.pathname);
  } catch {
    return url;
  }
}

const pageTitle = isAlias ? `${code} (numeric alias)` : primary ? primary.code : code;
const pageDescription = isAlias
  ? `The numeric value ${code} refers to other error codes.`
  : (primary?.description ?? '');

const statusPath = primary
  ? `errors.fyi/${primary.namespace}/${primary.code}`
  : `errors.fyi/${code}`;

const refs = primary?.references ?? [];
const otherEntries = entries.slice(1);
---

<Base title={pageTitle} description={pageDescription} hue={hue} path={statusPath}>
  {isAlias ? (
    <>
      <nav class="crumb">
        <a href="/">errors.fyi</a>
        <span class="sep">/</span>
        <span class="current">{code}</span>
      </nav>

      <section class="code-hero">
        <div class="pretag">numeric alias · refers to {entries.length} code{entries.length === 1 ? '' : 's'}</div>
        <div class="codebadge" set:html={`<span class="accent">${code}</span>`} />
        <h1>Numeric alias</h1>
        <p class="lede">The numeric value {code} doesn't have its own canonical entry — it's defined symbolically:</p>
      </section>

      <ul class="code-list">
        {entries.map((e) => (
          <li>
            <a href={`/${e.code}/`} style={`--hue: ${getHue(e.namespace)}`}>
              <span class="lc">{e.code}</span>
              <span class="ln">
                {e.name}
                {e.description && <span class="desc">{e.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </>
  ) : primary ? (
    <>
      <nav class="crumb">
        <a href="/">errors.fyi</a>
        <span class="sep">/</span>
        <a href={`/ns/${primary.namespace}/`}>{primary.namespace}</a>
        <span class="sep">/</span>
        <span class="current">{primary.code}</span>
      </nav>

      <div class="code-page">
        <div class="code-main">
          <section class="code-hero">
            <div class="pretag">{primary.namespace} · {primary.namespace}/{primary.code}</div>
            <div class="codebadge" set:html={formatBadge(primary.code)} />
            <h1>{primary.name}</h1>
            {primary.description && <p class="lede">{primary.description}</p>}
          </section>

          {otherEntries.length > 0 && (
            <section class="code-section">
              <h2>Also defined in</h2>
              <ul class="code-list">
                {otherEntries.map((e) => (
                  <li>
                    <a href={`/ns/${e.namespace}/`} style={`--hue: ${getHue(e.namespace)}`}>
                      <span class="lc">{e.namespace}</span>
                      <span class="ln">
                        {e.name}
                        {e.description && <span class="desc">{e.description}</span>}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {refs.length > 0 && (
            <section class="code-section">
              <h2>References</h2>
              <ul class="refs-list">
                {refs.map((ref) => (
                  <li><a href={ref} target="_blank" rel="noopener">{shortenRef(ref)}</a></li>
                ))}
              </ul>
            </section>
          )}

          {(prevCode || nextCode) && (
            <section class="code-section">
              <h2>In this namespace</h2>
              <div class="siblings">
                {prevCode ? (
                  <a href={`/${prevCode.code}/`} class="prev">
                    <span class="dir">← previous</span>
                    <span class="sc">{prevCode.code}</span>
                    <span class="sn">{prevCode.name}</span>
                  </a>
                ) : (
                  <div class="sibling-placeholder">— start of namespace —</div>
                )}
                {nextCode ? (
                  <a href={`/${nextCode.code}/`} class="next">
                    <span class="dir">next →</span>
                    <span class="sc">{nextCode.code}</span>
                    <span class="sn">{nextCode.name}</span>
                  </a>
                ) : (
                  <div class="sibling-placeholder sibling-placeholder-end">— end of namespace —</div>
                )}
              </div>
              {nearby.length > 0 && (
                <div class="nearby">
                  {nearby.map((c) => (
                    <a href={`/${c.code}/`} class={c.code === primary.code ? 'is-current' : ''}>
                      {c.code}
                    </a>
                  ))}
                </div>
              )}
            </section>
          )}
        </div>

        <aside class="code-aside">
          <div>
            <h4>Metadata</h4>
            <div class="kv">
              <div class="row">
                <span class="k">Namespace</span>
                <span class="v"><a href={`/ns/${primary.namespace}/`}>{primary.namespace}</a></span>
              </div>
              <div class="row">
                <span class="k">Code</span>
                <span class="v">{primary.code}</span>
              </div>
              <div class="row">
                <span class="k">Name</span>
                <span class="v">{primary.name}</span>
              </div>
              {primary.numeric !== undefined && (
                <div class="row">
                  <span class="k">Numeric</span>
                  <span class="v"><a href={`/${primary.numeric}/`}>{primary.numeric}</a></span>
                </div>
              )}
              <div class="row">
                <span class="k">Refs</span>
                <span class="v">{refs.length}</span>
              </div>
            </div>
          </div>
          <div>
            <h4>CLI</h4>
            <div class="cli-panel">
              <span class="cli-sigil">$</span> errorfyi&nbsp;{primary.code}
            </div>
          </div>
        </aside>
      </div>
    </>
  ) : null}
</Base>

<style>
  .sibling-placeholder {
    padding: 1rem 1.1rem;
    color: var(--muted-2);
    font-family: var(--mono);
    font-size: 12px;
  }
  .sibling-placeholder-end {
    text-align: right;
  }
  .cli-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.6rem 0.7rem;
    color: var(--text-2);
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.4;
  }
  .cli-sigil {
    color: var(--muted-2);
  }
</style>
