---
import Base from '../layouts/Base.astro';
import { getNamespaces, getAllCodes, getSample } from '../lib/data';
import { getHue } from '../lib/namespace-hues';

const namespaces = await getNamespaces();
const allCodes = await getAllCodes();

const namespaceCounts = new Map(
  namespaces.map((ns) => [
    ns.namespace,
    allCodes.filter((c) => c.namespace === ns.namespace).length,
  ])
);

const highlights = getSample(allCodes, 24);
---

<Base title="Error Code Reference" hue={25} path="errors.fyi">
  <section class="hero">
    <div class="hero-wordmark">
      errors<span class="dot"></span><span class="fyi">fyi</span>
    </div>
    <p class="hero-tagline">
      A community directory of error codes. Every code —
      <span class="accent">404</span>,
      <span class="accent">ENOENT</span>,
      <span class="accent">23505</span>
      — has a canonical page. Contributed and maintained on GitHub.
    </p>

    <form class="search" id="search-form">
      <span class="prefix">›</span>
      <input
        type="text"
        name="code"
        placeholder="Look up a code…  ENOENT · 404 · 23505 · ERR_MODULE_NOT_FOUND"
        autocomplete="off"
        spellcheck="false"
        aria-label="Error code"
      />
      <button type="submit">Look up ↵</button>
    </form>

    <div class="search-hints">
      <span class="label">try</span>
      {['404', 'ENOENT', 'ECONNREFUSED', '23505', 'ERR_MODULE_NOT_FOUND', 'NXDOMAIN'].map((c) => (
        <a href={`/${c}/`}>{c}</a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="section-title">From the directory</h2>
      <span class="section-meta">random sample · {highlights.length} / {allCodes.length.toLocaleString()}</span>
    </div>
    <ul class="sample-grid">
      {highlights.map((c) => (
        <li>
          <a href={`/${c.code}/`} style={`--hue: ${getHue(c.namespace)}`}>
            <span class="stag">{c.namespace}</span>
            <span class="scode">{c.code}</span>
            <span class="sname">{c.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="section-title">Namespaces</h2>
      <span class="section-meta">{namespaces.length} total · {allCodes.length.toLocaleString()} codes</span>
    </div>
    <ul class="ns-grid">
      {namespaces.map((ns) => (
        <li>
          <a href={`/ns/${ns.namespace}/`} style={`--hue: ${getHue(ns.namespace)}`}>
            <span class="swatch"></span>
            <span class="nsname">{ns.namespace}</span>
            <span class="nscount">{namespaceCounts.get(ns.namespace)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  document.getElementById('search-form')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const code = (e.target as HTMLFormElement).code.value.trim();
    if (code) window.location.href = `/${code}/`;
  });
</script>
