---
import Base from '../../layouts/Base.astro';
import { getNamespaces, getNamespace } from '../../lib/data';
import type { CodeEntry } from '../../lib/data';
import { getHue } from '../../lib/namespace-hues';

export async function getStaticPaths() {
  const namespaces = await getNamespaces();
  return namespaces.map((ns) => ({ params: { namespace: ns.namespace } }));
}

const { namespace } = Astro.params;
const { meta, codes } = await getNamespace(namespace);
const hue = getHue(namespace);

type CodeGroup = { mark: string; title: string; items: CodeEntry[] };

function groupCodes(ns: string, codes: CodeEntry[]): CodeGroup[] {
  if (['http', 'http2', 'http3'].includes(ns) || codes.every((c) => /^\d{3}$/.test(c.code))) {
    const buckets: Record<number, CodeEntry[]> = { 1: [], 2: [], 3: [], 4: [], 5: [] };
    for (const c of codes) {
      const k = Math.floor(parseInt(c.code, 10) / 100);
      if (buckets[k]) buckets[k].push(c);
    }
    const titles: Record<number, string> = {
      1: 'Informational',
      2: 'Success',
      3: 'Redirection',
      4: 'Client error',
      5: 'Server error',
    };
    return (Object.entries(buckets) as [string, CodeEntry[]][])
      .filter(([, arr]) => arr.length > 0)
      .map(([k, arr]) => ({ mark: k + 'xx', title: titles[parseInt(k)], items: arr }));
  }
  if (codes.length > 8 && codes.every((c) => /^E[A-Z]+$/.test(c.code))) {
    const buckets: Record<string, CodeEntry[]> = {};
    for (const c of codes) {
      const k = c.code[1];
      (buckets[k] = buckets[k] || []).push(c);
    }
    return Object.keys(buckets)
      .sort()
      .map((k) => ({
        mark: 'E' + k + '·',
        title: 'E' + k + '…',
        items: buckets[k],
      }));
  }
  return [{ mark: '·', title: 'All codes', items: codes.slice() }];
}

function shortenRef(url: string): string {
  try {
    const u = new URL(url);
    return u.host.replace(/^www\./, '') + (u.pathname === '/' ? '' : u.pathname);
  } catch {
    return url;
  }
}

const groups = groupCodes(namespace, codes);
const statusPath = `errors.fyi/ns/${namespace}`;
---

<Base title={meta.title} description={meta.description} hue={hue} path={statusPath}>
  <nav class="crumb">
    <a href="/">errors.fyi</a>
    <span class="sep">/</span>
    <span>ns</span>
    <span class="sep">/</span>
    <span class="current">{namespace}</span>
  </nav>

  <section class="ns-hero">
    <div>
      <div class="ns-tag">{namespace}</div>
      <h1>{meta.title}</h1>
      <p class="ns-desc">{meta.description}</p>
    </div>
    <div class="ns-stats">
      <span class="big">{codes.length}</span>
      <span class="lbl">codes</span>
    </div>
  </section>

  {meta.references && meta.references.length > 0 && (
    <div class="ns-refs">
      <span class="label">references</span>
      {meta.references.map((ref) => (
        <a href={ref} target="_blank" rel="noopener">{shortenRef(ref)}</a>
      ))}
    </div>
  )}

  {groups.map((group) => (
    <div class="classgroup">
      <div class="classgroup-head">
        <span class="cmark">{group.mark}</span>
        <span class="ctitle">{group.title}</span>
        <span class="ccount">{group.items.length} codes</span>
      </div>
      <ul class="code-list">
        {group.items.map((c) => (
          <li>
            <a href={`/${c.code}/`}>
              <span class="lc">{c.code}</span>
              <span class="ln">
                {c.name}
                {c.description && <span class="desc">{c.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</Base>
