---
import Base from '../layouts/Base.astro';
import { getEntriesForCode } from '../lib/data';
import { getCachedNamespace } from '../lib/ns-cache';
import { getHue } from '../lib/namespace-hues';

const http404entries = await getEntriesForCode('404');
const http404 = http404entries[0];
const http404hue = http404 ? getHue(http404.namespace) : 220;

let prevCode = null;
let nextCode = null;
let nearby: typeof http404entries = [];

if (http404) {
  const { codes: nsCodes } = await getCachedNamespace(http404.namespace);
  const idx = nsCodes.findIndex((c) => c.code === http404.code);
  prevCode = idx > 0 ? nsCodes[idx - 1] : null;
  nextCode = idx >= 0 && idx < nsCodes.length - 1 ? nsCodes[idx + 1] : null;
  const nearbyStart = Math.max(0, idx - 5);
  const nearbyEnd = Math.min(nsCodes.length, idx + 6);
  nearby = nsCodes.slice(nearbyStart, nearbyEnd);
}

function shortenRef(url: string): string {
  try {
    const u = new URL(url);
    return u.host.replace(/^www\./, '') + (u.pathname === '/' ? '' : u.pathname);
  } catch {
    return url;
  }
}
---

<Base title="Error Code" description="Error code lookup and unknown code reference." hue={http404hue} path="errors.fyi/404">
  <!-- Panel: shown when URL is exactly /404 (the real HTTP 404 entry) -->
  <div id="panel-code" hidden>
    <nav class="crumb">
      <a href="/">errors.fyi</a>
      <span class="sep">/</span>
      {http404 && <a href={`/ns/${http404.namespace}/`}>{http404.namespace}</a>}
      <span class="sep">/</span>
      <span class="current">404</span>
    </nav>

    {http404 && (
      <div class="code-page">
        <div class="code-main">
          <section class="code-hero">
            <div class="pretag">{http404.namespace} · {http404.namespace}/404</div>
            <div class="codebadge"><span class="accent">404</span></div>
            <h1>{http404.name}</h1>
            {http404.description && <p class="lede">{http404.description}</p>}
          </section>

          {http404.references && http404.references.length > 0 && (
            <section class="code-section">
              <h2>References</h2>
              <ul class="refs-list">
                {http404.references.map((ref) => (
                  <li><a href={ref} target="_blank" rel="noopener">{shortenRef(ref)}</a></li>
                ))}
              </ul>
            </section>
          )}

          {(prevCode || nextCode) && (
            <section class="code-section">
              <h2>In this namespace</h2>
              <div class="siblings">
                {prevCode ? (
                  <a href={`/${prevCode.code}/`} class="prev">
                    <span class="dir">← previous</span>
                    <span class="sc">{prevCode.code}</span>
                    <span class="sn">{prevCode.name}</span>
                  </a>
                ) : (
                  <div style="padding:1rem;color:var(--muted-2);font-family:var(--mono);font-size:12px">— start of namespace —</div>
                )}
                {nextCode ? (
                  <a href={`/${nextCode.code}/`} class="next">
                    <span class="dir">next →</span>
                    <span class="sc">{nextCode.code}</span>
                    <span class="sn">{nextCode.name}</span>
                  </a>
                ) : (
                  <div style="padding:1rem;color:var(--muted-2);font-family:var(--mono);font-size:12px;text-align:right">— end of namespace —</div>
                )}
              </div>
              {nearby.length > 0 && (
                <div class="nearby">
                  {nearby.map((c) => (
                    <a href={`/${c.code}/`} class={c.code === '404' ? 'is-current' : ''}>{c.code}</a>
                  ))}
                </div>
              )}
            </section>
          )}
        </div>

        <aside class="code-aside">
          <div>
            <h4>Metadata</h4>
            <div class="kv">
              <div class="row">
                <span class="k">Namespace</span>
                <span class="v"><a href={`/ns/${http404.namespace}/`}>{http404.namespace}</a></span>
              </div>
              <div class="row">
                <span class="k">Code</span>
                <span class="v">404</span>
              </div>
              <div class="row">
                <span class="k">Name</span>
                <span class="v">{http404.name}</span>
              </div>
              <div class="row">
                <span class="k">Refs</span>
                <span class="v">{http404.references?.length ?? 0}</span>
              </div>
            </div>
          </div>
          <div>
            <h4>CLI</h4>
            <div class="cli-panel">
              <span class="cli-sigil">$</span> errorfyi&nbsp;404
            </div>
          </div>
        </aside>
      </div>
    )}
  </div>

  <!-- Panel: shown for any unknown URL -->
  <div id="panel-unknown" hidden>
    <nav class="crumb">
      <a href="/">errors.fyi</a>
      <span class="sep">/</span>
      <span class="current" id="unknown-code">404</span>
    </nav>

    <section class="code-hero">
      <div class="pretag">unknown code</div>
      <div class="codebadge"><span class="accent">404</span></div>
      <h1 id="unknown-heading">No entry for this code</h1>
      <p class="lede">This code is not in the directory. If it's a real error code, consider opening a pull request to add it.</p>
    </section>

    <div style="margin-top:2rem">
      <a href="/" class="linklike">← back to errors.fyi</a>
    </div>
  </div>
</Base>

<script>
  const path = window.location.pathname.replace(/\/$/, '');
  const code = path.split('/').filter(Boolean).pop() ?? '';

  if (path === '/404' || path === '') {
    document.getElementById('panel-code')!.removeAttribute('hidden');
    document.documentElement.style.setProperty('--hue', String(Number(document.documentElement.style.getPropertyValue('--hue') || 220)));
  } else {
    document.getElementById('panel-unknown')!.removeAttribute('hidden');
    document.documentElement.style.setProperty('--hue', '15');
    const heading = document.getElementById('unknown-heading');
    const codeEl = document.getElementById('unknown-code');
    if (heading) heading.textContent = `No entry for "${code}"`;
    if (codeEl) codeEl.textContent = code || '404';
  }
</script>

<style>
  .cli-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.6rem 0.7rem;
    color: var(--text-2);
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.4;
  }
  .cli-sigil {
    color: var(--muted-2);
  }
</style>
