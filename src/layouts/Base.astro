---
import '../styles/global.css';
import { getTotals } from '../lib/totals';

interface Props {
  title: string;
  description?: string;
  hue?: number;
  path?: string;
}

const { title, description = 'A community directory of error codes.', hue = 25, path = 'errors.fyi' } = Astro.props;

const { nsCount, codeCount } = await getTotals();
---

<!doctype html>
<html lang="en" style={`--hue: ${hue}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — errors.fyi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="statusbar">
      <div class="row">
        <span class="prompt">
          <span class="sigil">$</span>
          <a href="/" class="path">{path}</a>
        </span>
        <span class="spacer"></span>
        <span class="meta">
          <span><b>{nsCount}</b>&nbsp;namespaces</span>
          <span class="sep">·</span>
          <span><b>{codeCount.toLocaleString()}</b>&nbsp;codes</span>
        </span>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <div class="statusbar statusbar-bottom">
      <div class="row">
        <span class="prompt">
          <span class="sigil">»</span>
          community-maintained · <a href="https://github.com/peterbraden/errors.fyi" target="_blank" rel="noopener">contribute on GitHub</a>
        </span>
        <span class="spacer"></span>
        <span class="meta mono">npm i -g errors-fyi&nbsp;&amp;&amp;&nbsp;errorfyi&nbsp;ENOENT</span>
      </div>
    </div>
  </body>
</html>
